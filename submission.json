     "title": "Metadata",
     "type": "object"
    },
    "task_id": {
     "default": "",
     "description": "Task being played",
     "title": "Task Id",
     "type": "string"
    },
    "output": {
     "default": "",
     "description": "Task text at reset, then the result of the last call",
     "title": "Output",
     "type": "string"
    },
    "ok": {
     "default": true,
     "description": "False when the last call was invalid",
     "title": "Ok",
     "type": "boolean"
    },
